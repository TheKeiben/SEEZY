<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- ========================================== -->
  <!-- 1. Package Identification                  -->
  <!-- ========================================== -->
  <name>controller</name>
  <version>0.0.0</version>
  <description>Controller package for managing ros2_control hardware interfaces and diff-drive kinematics</description>
  <maintainer email="SEEZY@gmail.com">SEEZY</maintainer>
  <license>Apache 2.0</license>
  <author email="SEEZY@gmail.com">SEEZY</author>

  <!-- ========================================== -->
  <!-- 2. Build Tool Dependencies                 -->
  <!-- ========================================== -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- ========================================== -->
  <!-- 3. Execution Dependencies                  -->
  <!-- ========================================== -->
  <!-- Python and Messages (Used at runtime if python nodes exist) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf_transformations</exec_depend>

  <!-- Control and Hardware interfaces -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  
  <!-- Launch tools -->
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- ========================================== -->
  <!-- 4. Test Dependencies                       -->
  <!-- ========================================== -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- ========================================== -->
  <!-- 5. Export Rules                            -->
  <!-- ========================================== -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>