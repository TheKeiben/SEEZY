<?xml version="1.0"?>

<robot name="robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- 1. Arguments and Includes                  -->
  <!-- ========================================== -->
  <!-- Start GZ or Ignition depending on ROS 2 Version -->
  <xacro:arg name="is_ignition" default="true"/>

  <!-- Load Simulated or Real Hardware Interfaces -->
  <xacro:arg name="is_sim" default="true"/>

  <!-- Include Gazebo Parameters -->
  <xacro:include filename="$(find description)/urdf/robot_gazebo.xacro" />

  <!-- Include ros2_control Plugins -->
  <xacro:include filename="$(find description)/urdf/robot_ros2_control.xacro" />

  <!-- ========================================== -->
  <!-- 2. Material Definitions                    -->
  <!-- ========================================== -->
   <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="silver">
    <color rgba="0.79 0.82 0.93 1"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>
  <material name="yellow">
    <color rgba="1.0 1.0 0.0 1"/>
  </material>

  <!-- ========================================== -->
  <!-- 3. Core Robot Base                         -->
  <!-- ========================================== -->
  <link name="base_footprint"/>
  
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <mass value="8.0"/>
      <inertia ixx="0.123" ixy="0.0" ixz="0.0"
               iyy="0.165" iyz="0.0"
               izz="0.234" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/chassis.stl" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/chassis.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link" />
    <origin xyz="0 0 0.0975" rpy="0 0 0"/>
  </joint>

  <!-- Top Cover -->  
  <link name="top_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/top.stl" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/top.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="top_joint" type="fixed">
    <origin xyz="0 0 0.234" rpy="0 0 0" /> 
    <parent link="base_link" />
    <child link="top_link" />
  </joint>

  <!-- ========================================== -->
  <!-- 4. Driving Wheels                          -->
  <!-- ========================================== -->
  
  <!-- Right Wheel -->
  <link name="wheel_right_link">
    <inertial>
      <origin xyz="0 -0.014 0" rpy="0 0 0" />
      <mass value="0.0530086090966721" />
      <inertia ixx="1.88176298336665E-05" ixy="-4.8444933029987E-10" ixz="1.88163708851143E-08"
               iyy="3.11510738647764E-05" iyz="-6.93560663069607E-11"
               izz="1.8801969558182E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/right_wheel.stl" />
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 -0.015 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.0975"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <origin xyz="0 -0.19 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="wheel_right_link" />
    <axis xyz="0 1 0" />
  </joint>
  
  <!-- Left Wheel -->
  <link
    name="wheel_left_link">
    <inertial>
      <origin xyz="0 0.014 0" rpy="0 0 0" />
      <mass value="0.0530086043217644" />
      <inertia ixx="1.8792911368909E-05"  ixy="3.31256392204584E-10" ixz="-1.14082001662767E-08"
               iyy="3.11510738759073E-05" iyz="-3.60499245082192E-10"
               izz="1.88266886146847E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/left_wheel.stl" />
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0.015 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.0975"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <origin xyz="0 0.19 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="wheel_left_link" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- ========================================== -->
  <!-- 5. Caster & Center Wheels                  -->
  <!-- ========================================== -->
  <!-- 
    Note: These links use fixed joints, so their mass/inertia is 
    automatically lumped into the base_link by Gazebo. 
  -->
  <link name="caster_rear_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/swivel.stl" />
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/swivel.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="caster_rear_joint" type="fixed">
    <origin xyz="-0.185 0 -0.04" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="caster_rear_link" />
  </joint>

  <link name="center_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/center_wheel.stl" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/center_wheel.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="center_wheel_joint" type="fixed">
    <origin xyz="-0.026 0 -0.016" rpy="0 0 0" />
    <parent link="caster_rear_link" />
    <child link="center_wheel_link" />
  </joint> 

  <!-- ========================================== -->
  <!-- 6. Sensors (LiDAR and Sonars)              -->
  <!-- ========================================== -->
  
  <!-- 2D Laser (LiDAR) -->
  <link name="laser">
    <inertial>
      <origin xyz="-0.011945780406062 -0.000381929217680526 -0.0170649378129477" rpy="0 0 0" />
      <mass value="0.073084435549317" />
      <inertia ixx="1.96074931730795E-05" ixy="-3.62091076640009E-07" ixz="4.28230084046735E-07"
               iyy="2.40983835136327E-05" iyz="1.50180909250652E-08"
               izz="4.14184164228595E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/laser_link.stl" />
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/laser_link.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <origin xyz="-0.055 0 0.02" rpy="0 0 0" />
    <parent link="top_link" />
    <child link="laser" />
  </joint>

<!-- Front Sonar -->
<link name="front_sonar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/front_sonar.stl" />
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/front_sonar.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="front_sonar_joint" type="fixed">
    <origin xyz="0.109 0 0.209" rpy="0 0 0" /> 
    <parent link="base_link" />
    <child link="front_sonar_link" />
  </joint>

  <!-- Back Sonar -->
  <link name="back_sonar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/back_sonar.stl" />
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://description/meshes/back_sonar.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="back_sonar_joint" type="fixed">
    <origin xyz="-0.198 0 0.208" rpy="0 0 0" /> 
    <parent link="base_link" />
    <child link="back_sonar_link" />
  </joint>

</robot>